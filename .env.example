# OpenAQ API Configuration
# Get your API key from: https://explore.openaq.org/register

# Single API key (standard usage)
OPENAQ_API_KEY=your-api-key-here

# Multiple API keys for faster downloads (optional)
# Each additional key multiplies your rate limit
# Example: 3 keys = 180 requests/minute
# OPENAQ_API_KEY_01=first-key-here
# OPENAQ_API_KEY_02=second-key-here
# OPENAQ_API_KEY_03=third-key-here
# ... up to OPENAQ_API_KEY_100

# Weather Data API Configuration

# ERA5 - Copernicus Climate Data Store
# Register at: https://cds.climate.copernicus.eu/
# CDS_API_KEY=your-cds-api-key-here

# CAMS - Copernicus Atmosphere Monitoring Service
# Register at: https://ads.atmosphere.copernicus.eu/
# Get your API key from your profile page (key only, NOT including UID:)
# Note: CAMS_API_UID is optional, only the API key is needed
# CAMS_API_UID=123456  # Optional - not used by new API
# CAMS_API_KEY=abcdef-1234-5678-90ab-cdef12345678

# NASA POWER - No API key required
# JMA AMeDAS - No API key required

# Fire Detection API Configuration

# NASA FIRMS - Fire Information for Resource Management System
# Register at: https://firms.modaps.eosdis.nasa.gov/api/
# FIRMS_API_KEY=your-firms-api-key-here